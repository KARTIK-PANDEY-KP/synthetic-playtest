# Base URL of the orchestrator (apps/orchestrator, port 4000). Read in the browser.
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:4000

# Optional fallback if the orchestrator has no CORS headers: proxy /api/* through Next.
# Use together with NEXT_PUBLIC_ORCHESTRATOR_URL="" (same-origin).
# ORCHESTRATOR_URL=http://localhost:4000
